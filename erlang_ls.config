diagnostics:
  enabled:
    - crossref
    - dialyzer
    - eunit
apps_dirs:
  - "src"
  - "src/*"
include_dirs:
  - "src"
  - "src/include"
  - "_build/default/lib"
  - "_build/default/lib/*/include"
lenses:
  enabled:
    - ct-run-test
    - show-behaviour-usages
providers:
  enabled:
    - signature-help
  disabled:
    - document-formatting
