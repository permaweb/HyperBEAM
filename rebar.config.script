%% Make the in-repo hb_device app available to rebar3's local plugin loader.
filelib:ensure_dir("_checkouts/.keep"),
case file:read_link("_checkouts/hb_device") of
    {ok, "../apps/hb_device"} -> ok;
    {ok, _Other} ->
        file:delete("_checkouts/hb_device"),
        file:make_symlink("../apps/hb_device", "_checkouts/hb_device");
    {error, enoent} ->
        file:make_symlink("../apps/hb_device", "_checkouts/hb_device");
    {error, einval} -> ok
end,
CONFIG.
