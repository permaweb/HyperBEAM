      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10000
              },
              {
                "color": "orange",
                "value": 100000
              },
              {
                "color": "red",
                "value": 250000
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "max(last_over_time({container=\"hyperbeam\"} |= \"computed_slot,\" | regexp `target_slot: (?P<target_slot>\\d+)` | unwrap target_slot [$__interval])) - max(last_over_time({container=\"hyperbeam\"} |= \"computed_slot,\" | regexp `slot: (?P<slot>\\d+), target_slot` | unwrap slot [$__interval]))",
          "legendFormat": "lag",
          "refId": "A"
