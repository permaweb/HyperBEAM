#!/bin/sh
# lapee-splash -- pre-rendered animated boot splash.
#
# Frames are baked at build time by scripts/gen-splash-frames.sh and
# shipped as static text files under /etc/lapee/splash-frames/. The
# daemon is a pure busybox-sh loop: read the state file, cat the
# appropriate frame to /dev/console, overlay phase footer + IP via
# cursor positioning, sleep, repeat.
#
# Why pre-rendered? Earlier versions ran an 800-line awk script with
# 3D rotation math on every frame. Elegant but fragile across awks
# (BSD vs busybox) and busybox initramfs that lack /dev/stdin. Pre-
# rendered frames have one runtime dependency (cat + printf + sleep,
# all in busybox), so they either work or fail loudly with a clear
# error -- no silent crashes.

STATE_DIR=${LAPEE_STATE_DIR:-/run/lapee}
STATE_FILE=${LAPEE_STATE_FILE:-$STATE_DIR/splash.state}
FRAMES_DIR=${LAPEE_FRAMES_DIR:-/etc/lapee/splash-frames}
CONSOLE=${LAPEE_CONSOLE:-/dev/console}

set_state() {
    mkdir -p "$STATE_DIR" 2>/dev/null || return 1
    _tmp=$STATE_FILE.tmp.$$
    printf '%s\n' "$*" > "$_tmp" 2>/dev/null || return 1
    mv "$_tmp" "$STATE_FILE" 2>/dev/null || return 1
}

# Parse state file into globals: phase, data_ip, data_msg
read_state() {
    phase=""
    data_ip=""
    data_msg=""
    [ -r "$STATE_FILE" ] || return 0
    _line=$(cat "$STATE_FILE" 2>/dev/null)
    for _tok in $_line; do
        case "$_tok" in
            phase=*) phase="${_tok#phase=}" ;;
            ip=*)    data_ip="${_tok#ip=}" ;;
            msg=*)   data_msg="${_tok#msg=}" ;;
        esac
    done
}

footer_text() {
    case "$1" in
        boot)     echo "booting..." ;;
        net-up)   echo "interfaces up; starting HyperBEAM..." ;;
        net-none) echo "no network found -- plug in Ethernet" ;;
        net-wait) echo "waiting for network..." ;;
        hb-wait)  echo "waiting for HyperBEAM..." ;;
        qr)       if [ -n "$2" ]; then echo "scan -> http://$2:8734/"
                  else                 echo "ready"
                  fi ;;
        halted)   echo "HALTED${data_msg:+: $data_msg}" ;;
        *)        echo "" ;;
    esac
}

daemon() {
    if grep -qw 'lapee\.nosplash=1' /proc/cmdline 2>/dev/null; then
        static_splash 'booting...'
        exec sh -c 'while :; do sleep 3600; done'
    fi
    printf '\033[?25l\033[2J\033[H' > "$CONSOLE" 2>/dev/null || true
    [ -f "$STATE_FILE" ] || set_state 'phase=boot'

    # Count frames
    nframes=0
    for f in "$FRAMES_DIR"/frame-*.txt; do
        [ -f "$f" ] || continue
        nframes=$((nframes + 1))
    done
    if [ "$nframes" -eq 0 ]; then
        printf 'lapee-splash: no frames in %s\n' "$FRAMES_DIR" \
            > "$CONSOLE" 2>/dev/null
        exec sh -c 'while :; do sleep 3600; done'
    fi

    F=0
    while :; do
        read_state
        if [ "$phase" = "exit" ]; then break; fi

        # Cursor home, paint frame
        printf '\033[H' > "$CONSOLE" 2>/dev/null || true
        idx=$(printf '%03d' "$F")
        cat "$FRAMES_DIR/frame-$idx.txt" > "$CONSOLE" 2>/dev/null || true

        # Footer text overlaid at fixed row 24 (25-line terminal)
        ftxt=$(footer_text "$phase" "$data_ip")
        if [ -n "$ftxt" ]; then
            ftxt_len=${#ftxt}
            pad=$(( (80 - ftxt_len) / 2 ))
            [ "$pad" -lt 0 ] && pad=0
            printf '\033[24;1H\033[2K%*s%s' \
                "$pad" "" "$ftxt" > "$CONSOLE" 2>/dev/null || true
        fi

        # Banner at row 25
        banner='LapEE . HyperBEAM . Trusted Execution Environment'
        b_len=${#banner}
        b_pad=$(( (80 - b_len) / 2 ))
        [ "$b_pad" -lt 0 ] && b_pad=0
        printf '\033[25;1H\033[2K%*s%s' \
            "$b_pad" "" "$banner" > "$CONSOLE" 2>/dev/null || true

        F=$(( (F + 1) % nframes ))
        sleep 0.16 2>/dev/null || sleep 1
    done

    # Cleanup
    printf '\033[?25h\n' > "$CONSOLE" 2>/dev/null || true
}

static_splash() {
    _msg=${1:-LapEE}
    printf '\n\n   %s\n\n' "$_msg" > "$CONSOLE" 2>/dev/null || true
}

do_set() {
    _line="$*"
    mkdir -p "$STATE_DIR" 2>/dev/null || true
    _tmp="$STATE_FILE.tmp.$$"
    printf '%s\n' "$_line" > "$_tmp"
    mv "$_tmp" "$STATE_FILE"
}

case "${1-}" in
    daemon) daemon ;;
    set)    shift; do_set "$@" ;;
    "")     static_splash ;;
    *)      static_splash "$1" ;;
esac
