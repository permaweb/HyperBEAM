#!/bin/sh
# LapEE guest init — PID 1 for HyperBEAM-as-userspace.
#
# Responsibilities:
#   1. Mount the essentials.
#   2. Parse /proc/cmdline for a user config snippet (optional,
#      LAPEE_USER_CONFIG=<file:path>).
#   3. Assemble HB_CONFIG as a comma-separated list: the user config
#      (if any) first, the enforced config LAST so it always wins.
#   4. exec the HyperBEAM release in foreground mode.
#
# This script is deliberately tiny — all key generation, PCR extension,
# and attestation logic lives in dev_tpm2 via the on.start hook.
set -eu

mount -t proc  -o nosuid,noexec,nodev  proc  /proc
mount -t sysfs -o nosuid,noexec,nodev  sysfs /sys
mount -t devtmpfs -o nosuid            devtmpfs /dev
mount -t tmpfs -o nosuid,nodev         tmpfs /tmp
mount -t tmpfs -o nosuid,nodev         tmpfs /run
mkdir -p /dev/pts
mount -t devpts -o nosuid,noexec devpts /dev/pts
mount -t securityfs securityfs /sys/kernel/security 2>/dev/null || true

# v1.2: Boot splash -- centred HyperBEAM ASCII art + a status
# line that starts as "booting..." and gets replaced when we
# know more. Each visibility stage writes a fresh splash so
# the audience always sees *something* happening. Final status
# lands when an interface gets a DHCP lease
# (`lapee-dhcp-hook' -> `http://<ip>:8734').
if [ -x /usr/local/bin/lapee-splash ]; then
    /usr/local/bin/lapee-splash "booting..." \
        > /dev/console 2>/dev/null || true
fi
echo "[init] kernel=$(uname -r)"

# --- Networking (v1.2 A2-A5) -------------------------------------
#
# Enumerate every physical NIC, bring it up, and fork a udhcpc in
# the background. The first interface to get a lease wins -- it
# becomes the default gateway (see /usr/local/bin/lapee-dhcp-hook).
# This matches the precedence Sam asked for:
#   (a) built-in wired Ethernet (enp*, eth*)
#   (b) USB-C Ethernet dongle (enp*u*, usb*)
#   (c) Thunderbolt-bridge via USB4_NET (thunderbolt*)
#   (d) USB RNDIS tether (rndis*)
# The kernel assigns ascending names in roughly that order on a
# real boot, so "first to lease wins" does the right thing without
# explicit ranking. Secondary interfaces keep their IP for
# diagnostics and hot-swap but don't overwrite the default route.
#
# QEMU compatibility: slirp (`-netdev user') includes a DHCP
# server at 10.0.2.2, so this path works unchanged in QEMU --
# no more hard-coded 10.0.2.15 fallback.

ip link set lo up 2>/dev/null || true

# Create the scratch dir BEFORE udhcpc -- its log redirect would
# otherwise fail the command. /run is already tmpfs-mounted above.
mkdir -p /run/lapee /etc/lapee

NIC_COUNT=0
for iface in /sys/class/net/*; do
    name=$(basename "$iface")
    case "$name" in
        lo|bonding_masters|bonding|ip6tnl0|tunl0|sit0) continue ;;
    esac
    [ -e "$iface/device" ] || continue
    echo "[init] net: up $name"
    ip link set "$name" up 2>/dev/null || true
    udhcpc -i "$name" -b -t 5 -T 1 -A 2 \
           -p "/run/udhcpc.$name.pid" \
           -s /usr/local/bin/lapee-dhcp-hook \
           >> /run/lapee/udhcpc.log 2>&1 \
           || echo "[net] $name: udhcpc launch failed"
    NIC_COUNT=$((NIC_COUNT + 1))
done
echo "[init] net: $NIC_COUNT interface(s) enumerated; DHCP in flight"

# Give the user a visible status before HB is up. If there's no
# network, the splash WILL stay on this message until the
# writeback completes -- that's the correct signal ("I see zero
# interfaces; plug in an Ethernet cable").
if [ -x /usr/local/bin/lapee-splash ]; then
    if [ "$NIC_COUNT" -eq 0 ]; then
        /usr/local/bin/lapee-splash \
            "no network interfaces found -- plug in Ethernet" \
            > /dev/console 2>/dev/null || true
    else
        /usr/local/bin/lapee-splash \
            "$NIC_COUNT interface(s) up; starting HyperBEAM..." \
            > /dev/console 2>/dev/null || true
    fi
fi

# Default config files (shipped with image).
ENFORCED_CFG=/etc/lapee/lapee-enforced.flat
USER_CFG_DEFAULT=/etc/lapee/user.flat

# Optional user config via kernel cmdline: `lapee.userconfig=<path>' or
# `lapee.user_b64=<base64_of_flat_file_contents>'.
USER_CFG_CMDLINE=$(sed -n 's/.*lapee\.userconfig=\([^ ]*\).*/\1/p' /proc/cmdline)
USER_B64=$(sed -n 's/.*lapee\.user_b64=\([^ ]*\).*/\1/p' /proc/cmdline)

USER_CFG=""
if [ -n "$USER_B64" ]; then
    mkdir -p /run/lapee
    echo "$USER_B64" | base64 -d > /run/lapee/user-cmdline.flat
    USER_CFG=/run/lapee/user-cmdline.flat
elif [ -n "$USER_CFG_CMDLINE" ] && [ -f "$USER_CFG_CMDLINE" ]; then
    USER_CFG=$USER_CFG_CMDLINE
elif [ -f "$USER_CFG_DEFAULT" ]; then
    USER_CFG=$USER_CFG_DEFAULT
fi

# Build HB_CONFIG; enforced LAST so its keys win.
if [ -n "$USER_CFG" ]; then
    HB_CONFIG="$USER_CFG,$ENFORCED_CFG"
    echo "[init] user config: $USER_CFG"
else
    HB_CONFIG="$ENFORCED_CFG"
fi
echo "[init] HB_CONFIG = $HB_CONFIG"
export HB_CONFIG

# TPM access.
export LAPEE_TPM_TCTI=${LAPEE_TPM_TCTI:-device:/dev/tpm0}

# Diagnostic: when LAPEE_HB_VERBOSE=1 is in /proc/cmdline, turn on HB
# startup tracing so we can see where HB hangs during boot. The setting
# is opt-in because the output is very noisy.
if grep -q 'LAPEE_HB_VERBOSE=1' /proc/cmdline 2>/dev/null; then
    export HB_PRINT="http,boot,start,hook,debug_router_info"
    echo "[init] HB_PRINT = $HB_PRINT (verbose boot diagnostics)"
fi

# Force HB into `debug' mode so it doesn't try to reach Arweave gateways
# on startup (the guest's user-mode networking can't reach the outside
# world in a useful way for attestation demos).
export HB_MODE=${HB_MODE:-debug}

# /etc/lapee + /run/lapee were pre-created in the networking block
# above so udhcpc's log redirect doesn't fail. The real EK
# certificate (if the platform TPM has one provisioned) is read
# from NV storage by lapee_tpm_nif:nv_read/1 inside dev_tpm2 --
# there is no CA to generate here, and no CA file to dump to the
# console. If the TPM's NV has no EK cert, the attestation envelope
# records that explicitly in `ek-cert-source.kind = "absent"'.
# No fakes.

# Quick boot-state report (helps debugging).
echo "[init] /sys/class/tpm:"
ls /sys/class/tpm/ 2>&1 | head -3
if [ -f /sys/class/tpm/tpm0/tpm_version_major ]; then
    echo "[init] TPM v$(cat /sys/class/tpm/tpm0/tpm_version_major)"
fi

# Diagnostic: when LAPEE_HB_DIAG=1 is in /proc/cmdline, listen on port
# 8734 with busybox nc and dump the first request to console. The host
# test harness fires `curl http://127.0.0.1:${HOST_HTTP_PORT}/diag-probe'
# at us during this window. If the nc listener reports the bytes,
# slirp hostfwd is wired correctly and the blocker is in HB's cowboy
# stack; if nc stays silent, slirp isn't delivering and we need a
# non-slirp transport.
if grep -q 'LAPEE_HB_DIAG=1' /proc/cmdline 2>/dev/null; then
    set +e  # stay alive through any subcommand failure
    echo "--- LAPEE-DIAG-BEGIN ---"
    echo "[diag] address state:"
    ip addr show eth0 2>&1 | head -6
    echo "[diag] routes:"
    ip route 2>&1 | head -6
    echo "[diag] listening on 0.0.0.0:8734 via busybox nc (up to 30s)..."
    # busybox nc: `-l -p PORT` listens; without -w the server reads
    # until the client closes or timeout. We run it under `timeout'
    # so we don't hang the diag window forever.
    timeout 30 nc -l -p 8734 2>&1 | sed 's/^/[diag-recv] /' &
    NCPID=$!
    # Keep the DIAG window open long enough for the host probe.
    sleep 15
    # Tell the host "ready" explicitly on the console so the host
    # harness doesn't have to race on the nc message.
    echo "[diag] nc listener is live — window closes in 15s more"
    sleep 20
    # Reap the listener if still around.
    kill $NCPID 2>/dev/null
    wait $NCPID 2>/dev/null
    echo "[diag] nc window closed."
    echo "[diag] outbound reachability (slirp default gw 10.0.2.2):"
    # busybox nc without -z: try connecting to a well-known port on
    # the host; failure is fine, we only want log lines.
    echo "" | timeout 3 nc -w 3 10.0.2.2 80 2>&1 | head -3 \
        | sed 's/^/[diag-out-80] /'
    echo "--- LAPEE-DIAG-END ---"
    echo "[diag] holding init — kill qemu from the host when done"
    # busybox `sleep infinity' keeps PID 1 alive so the kernel does not
    # panic. We intentionally do not exec a shell: the serial stdin is
    # closed (qemu backgrounded), so the shell would read EOF and exit.
    while :; do sleep 3600; done
fi

cd /usr/lib/hyperbeam

# USB-stick round-trip validation path (opt-in via kernel cmdline
# `LAPEE_WRITEBACK=1'). Used when a Framework boots this image
# from a USB stick and we want the attested envelope to end up
# back on the same stick so the operator can interpret it on
# their verifier host after power-off. Required kernel builtins
# are all present in vmlinuz-lapee: CONFIG_USB_STORAGE,
# CONFIG_VFAT_FS, CONFIG_BLK_DEV_SD, CONFIG_USB_XHCI_HCD —
# no modprobes, no network.
if grep -q 'LAPEE_WRITEBACK=1' /proc/cmdline 2>/dev/null; then
    echo "[init] LAPEE_WRITEBACK=1 - running HB in background, will"
    echo "[init] write attestation to ESP partition labelled"
    echo "[init] LAPEE_ESP after the node comes up."
    /usr/lib/hyperbeam/bin/hb foreground \
        > /run/lapee/hb.log 2>&1 &
    HB_PID=$!

    # Two-phase wait. Phase 1: probe the cheap /info handler
    # with short wget timeouts, logging progress every 10
    # iterations so the console shows we're alive. Rosetta-
    # emulated amd64 BEAM startup under QEMU takes 60-180s to
    # reach cowboy-listen state; real hardware is much faster.
    #
    # `accept-bundle: true' routes around HB's auto-index
    # generation in dev_codec_httpsig_conv (which otherwise
    # hits an `{error, not_found}' on HB's cold store and
    # loops the reply encoder).
    #
    # Phase 2: a single `/attestation' call with a long timeout
    # (quotes are expensive: 2-5s of TPM work per request). One
    # call = one quote = one envelope.
    mkdir -p /mnt/esp /run/lapee
    PROBE_OUT=/run/lapee/probe.json
    ATT_OUT=/run/lapee/attestation.json

    echo "[writeback] phase 1: waiting for HB to answer /~tpm2@2.0a/info"
    # Visible splash update so the audience sees something is
    # happening during HB's cold-start (LMDB warmup, crypto
    # init, TPM first-use can take a few seconds on iron and
    # longer under Rosetta). Without this the screen is frozen
    # on the initial splash for the whole wait.
    if [ -x /usr/local/bin/lapee-splash ]; then
        /usr/local/bin/lapee-splash \
            "waiting for HyperBEAM..." \
            > /dev/console 2>/dev/null || true
    fi
    ready=0
    for i in $(seq 1 120); do
        if wget -q -O "$PROBE_OUT" --timeout=2 \
                --header='accept: application/json@1.0' \
                --header='accept-bundle: true' \
                http://127.0.0.1:8734/~tpm2@2.0a/info \
                2>/dev/null && [ -s "$PROBE_OUT" ]; then
            echo "[writeback] HB responded to /info after ~$((i*3))s"
            ready=1; break
        fi
        # Heartbeat every 5 probes (~10s of wall-time) so the
        # operator sees the boot is progressing, not hung.
        # Every 10th also refreshes the splash -- kernel WARN
        # messages above loglevel=1 are suppressed now but the
        # initial UEFI boot logo can still scroll past.
        if [ $((i % 5)) -eq 0 ]; then
            echo "[writeback] phase 1: still waiting (probe ${i}/120" \
                 "~$((i*2))s elapsed)"
        fi
        if [ $((i % 10)) -eq 0 ] && \
           [ -x /usr/local/bin/lapee-splash ]; then
            /usr/local/bin/lapee-splash \
                "waiting for HyperBEAM... (~$((i*2))s)" \
                > /dev/console 2>/dev/null || true
        fi
        sleep 2
    done

    if [ $ready -ne 1 ]; then
        echo "[writeback] FAIL - HB did not answer /info in ~360s"
        echo "[writeback] tail of /run/lapee/hb.log:"
        tail -80 /run/lapee/hb.log 2>/dev/null
    else
        echo "[writeback] phase 2: calling /~tpm2@2.0a/attestation (quote takes ~5s)"
        if wget -q -O "$ATT_OUT" --timeout=120 \
                --header='accept: application/json@1.0' \
                --header='accept-bundle: true' \
                http://127.0.0.1:8734/~tpm2@2.0a/attestation \
                2>/dev/null && [ -s "$ATT_OUT" ]; then
            ATT_BYTES=$(wc -c < "$ATT_OUT")
            echo "[writeback] phase 2: got $ATT_BYTES bytes"
        else
            echo "[writeback] FAIL - /attestation returned empty or error"
            tail -40 /run/lapee/hb.log 2>/dev/null
            ATT_OUT=""
        fi

        # Find the ESP + write the envelope. Busybox does not
        # ship a `blkid' applet that supports label lookup, so
        # we take the robust path: try-mount every block-device
        # partition as vfat-RO and check for the ESP marker file
        # `/EFI/Boot/BootX64.efi' (which this UKI image always
        # writes at build time). This works on USB mass-storage
        # (/dev/sdXN on real hardware + QEMU emulated), virtio-
        # blk (/dev/vdXN under QEMU), NVMe (/dev/nvmeXnYpZ),
        # and eMMC (/dev/mmcblkXpY) without any extra tools.
        ESP_DEV=""
        if [ -n "$ATT_OUT" ]; then
            for iter in $(seq 1 20); do
                for dev in /dev/sd[a-z][0-9]* \
                           /dev/vd[a-z][0-9]* \
                           /dev/nvme[0-9]n[0-9]p[0-9]* \
                           /dev/mmcblk[0-9]p[0-9]*; do
                    [ -b "$dev" ] || continue
                    if mount -t vfat -o ro,noatime "$dev" /mnt/esp \
                          2>/dev/null; then
                        if [ -f /mnt/esp/EFI/Boot/BootX64.efi ]; then
                            ESP_DEV=$dev
                            umount /mnt/esp 2>/dev/null
                            break 2
                        fi
                        umount /mnt/esp 2>/dev/null
                    fi
                done
                sleep 1
            done
        fi
        if [ -z "$ESP_DEV" ] && [ -n "$ATT_OUT" ]; then
            echo "[writeback] FAIL - could not locate LapEE ESP"
            echo "[writeback] block devices:"
            ls /dev/sd* /dev/vd* /dev/nvme* /dev/mmcblk* \
                2>/dev/null | sed 's/^/[writeback]   /'
        elif [ -n "$ESP_DEV" ]; then
            echo "[writeback] ESP = $ESP_DEV"
            if mount -t vfat -o rw,noatime "$ESP_DEV" /mnt/esp; then
                STAMP=$(date +%Y%m%dT%H%M%SZ 2>/dev/null || echo run)
                OUT=/mnt/esp/attestation-$STAMP.json
                LINK=/mnt/esp/attestation-latest.json
                cp "$ATT_OUT" "$OUT" && ATT_OK=1 || ATT_OK=0
                if [ "$ATT_OK" = "1" ] && [ -s "$OUT" ]; then
                    rm -f "$LINK"
                    cp "$OUT" "$LINK"
                    cat > /mnt/esp/README-VALIDATOR.txt <<RV
LapEE attestation written on boot $STAMP.

On your verifier host (with the USB stick plugged in):

    ./lapee-baremetal/scripts/interpret-local-capture.sh \\
        --label "Framework (USB roundtrip)" \\
        /Volumes/LAPEE_ESP/attestation-latest.json

The JSON is the full envelope returned by
\`~tpm2@2.0a/attestation\`. The EK certificate (when the
platform TPM has one provisioned in NV storage) is embedded
inline as the \`ek-cert-pem\` field. Its provenance is
recorded under \`ek-cert-source\`:

    {"kind": "tpm-nv", "handle": "0x01C00002", "bytes": 1234}
        EK cert read from the TPM's NV storage at the TCG-
        standard low-range index. Chain-valid against the
        matching vendor EK root CA shipped in the verifier.

    {"kind": "absent", "reason": ...}
        The TPM has no EK cert provisioned at any of the
        TCG-standard indices. The attestation still carries
        the live TPM quote + PCR set; the EK chain check
        will fail because there is nothing to chain. This
        is expected on some AMD fTPM configurations where
        the cert is fetched out-of-band from AMD PSP. It is
        NOT an error from LapEE -- we deliberately never
        substitute a synthetic cert.
RV
                    sync
                    SZ=$(stat -c %s "$OUT" 2>/dev/null || \
                           stat -f %z "$OUT" 2>/dev/null || echo ?)
                    echo "==============================================="
                    echo "   LAPEE-WRITEBACK-OK: $OUT ($SZ bytes)"
                    echo "   ALSO: $LINK"
                    echo "   SAFE TO POWER OFF + REMOVE USB STICK"
                    echo "==============================================="
                else
                    echo "[writeback] FAIL - wget could not fetch /attestation"
                fi
                umount /mnt/esp || true
            else
                echo "[writeback] FAIL - mount -o rw on $ESP_DEV"
            fi
        fi
    fi

    # Keep HB in foreground so the node stays up for any
    # follow-on interactive use over the serial console.
    wait $HB_PID
else
    echo "[init] exec hyperbeam"
    echo "-----------------------------------------------"
    exec /usr/lib/hyperbeam/bin/hb foreground
fi
