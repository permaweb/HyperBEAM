#!/bin/sh
# lapee-dhcp-hook -- udhcpc action script. Called by udhcpc on
# deconfig / bound / renew / nak / leasefail events. Busybox's
# udhcpc passes state via $1 (action) and the lease as env vars
# (ip, subnet, router, dns, lease).
#
# Policy: the FIRST interface to get a lease wins and becomes the
# default route; later interfaces keep their IP for diagnostics
# but do NOT overwrite the default. This implements the v1.2
# precedence spec: whichever wired interface appears first with
# carrier gets promoted; later (or slower) ones stay in the
# background. iproute2 accepts a dotted-decimal subnet mask
# directly (`ip addr add 1.2.3.4/255.255.255.0'), which keeps
# this hook small + dependency-free.

set -eu
: "${interface:=unknown}"

PRIMARY=/run/lapee/primary-net
mkdir -p /run/lapee

case "${1:-unknown}" in
    deconfig)
        ip -4 addr flush dev "$interface" 2>/dev/null || true
        ip link set "$interface" up 2>/dev/null || true
        ;;

    bound|renew)
        if [ -z "${ip:-}" ]; then
            echo "[net] $interface: bound event without ip= -- skipping"
            exit 0
        fi
        mask=${subnet:-255.255.255.0}
        ip -4 addr flush dev "$interface" 2>/dev/null || true
        ip -4 addr add "$ip/$mask" dev "$interface" \
            2>/dev/null || true
        ip link set "$interface" up 2>/dev/null || true

        if [ ! -s "$PRIMARY" ]; then
            # Only claim the primary slot if DHCP actually gave us
            # a default gateway. Some networks (hotel captive
            # portals, 802.1x walled gardens) hand out an IP with
            # no router option. Writing to PRIMARY here would
            # block any subsequent interface from becoming the
            # real default, so we leave the slot empty and log
            # that the lease is ip-only (useful data for
            # diagnostics, not promoted to primary).
            if [ -z "${router:-}" ]; then
                echo "[net] $interface: bound ip=$ip" \
                     "NO-GATEWAY (ip-only; not promoting to primary)"
            else
                for gw in ${router:-}; do
                    ip -4 route replace default via "$gw" \
                        dev "$interface" 2>/dev/null || true
                done
                if [ -n "${dns:-}" ]; then
                    : > /etc/resolv.conf || true
                    for n in $dns; do
                        echo "nameserver $n" >> /etc/resolv.conf
                    done
                fi
                printf "iface=%s\nip=%s\ngw=%s\ndns=%s\n" \
                    "$interface" "$ip" "${router:-}" \
                    "${dns:-}" > "$PRIMARY"
                echo "[net] $interface: bound ip=$ip" \
                     "gw=${router:-} dns=${dns:-none}  (primary)"
                # Kick off QR pre-render with the bound IP so it's
                # ready to overlay the moment we flip to qr phase.
                # We stay on hb-wait until HB actually answers
                # /info -- the QR shouldn't appear before the node
                # can accept requests, or a too-eager scanner would
                # hit ECONNREFUSED.
                #
                # The set command writes /run/lapee/qr.txt as a
                # side-effect when it sees ip=..., so the daemon
                # can pick it up instantly on the next phase flip.
                if [ -x /usr/local/bin/lapee-splash ]; then
                    /usr/local/bin/lapee-splash set hb-wait \
                        "ip=$ip" 2>/dev/null || true
                fi
                # Fork a one-shot `/info' watcher in the non-
                # writeback code path. Writeback init does its own
                # /info polling + phase flip inline (see init) so
                # we would be double-flipping there; the `[ ! -f ]'
                # test suppresses the watcher when init has already
                # started its own wait loop. The watcher probes
                # 127.0.0.1 instead of $ip because HB may be bound
                # only to localhost on cold-start (config depends
                # on router device).
                _watchlock=/run/lapee/hb-ready-watcher.pid
                if [ ! -f "$_watchlock" ]; then
                    (
                        echo $$ > "$_watchlock"
                        # Poll for up to ~240s. Match the
                        # writeback-path budget -- cold BEAM +
                        # TPM first-use can take 60-120s on iron.
                        for _i in $(seq 1 120); do
                            if wget -q -O /dev/null --timeout=2 \
                                    --header='accept: application/json@1.0' \
                                    --header='accept-bundle: true' \
                                    http://127.0.0.1:8734/~tpm2@2.0a/info \
                                    2>/dev/null; then
                                /usr/local/bin/lapee-splash set qr \
                                    "ip=$ip" 2>/dev/null
                                break
                            fi
                            sleep 2
                        done
                        rm -f "$_watchlock"
                    ) &
                fi
            fi
        else
            echo "[net] $interface: bound ip=$ip  (secondary;" \
                 "keeping default route from $(cat "$PRIMARY" \
                    | sed -n 's/^iface=//p'))"
        fi
        ;;

    nak|leasefail)
        echo "[net] $interface: $1 (no lease)"
        ;;

    *)
        ;;
esac

exit 0
