#!/bin/sh
# hyperbeam wrapper — exec the HyperBEAM release binary with a default cookie.
#
# The release-generated `hb` script is relocatable; it resolves its own paths
# via the RELX_REPLACE_OS_VARS mechanism when invoked with a release_name.
set -eu

RELX_REPLACE_OS_VARS=true \
    HB_COOKIE="${HB_COOKIE:-lapee-node}" \
    exec /usr/lib/hyperbeam/bin/hb foreground "$@"
