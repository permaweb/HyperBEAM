%% lapee_tpm — Linux/amd64 build against system libtss2-dev + libssl-dev.
{erl_opts, [debug_info]}.

{deps, []}.

{plugins, [pc]}.

{provider_hooks,
 [{post, [{compile, {pc, compile}}, {clean, {pc, clean}}]}]}.

{port_specs,
 [{"priv/lapee_tpm_nif.so",
   ["c_src/lapee_tpm_nif.c", "c_src/tpm_helpers.c"]}]}.

{port_env,
 [
  {"CFLAGS",
   "$CFLAGS -std=c11 -Wall -Wextra -Wno-unused-parameter -fPIC -O2"},

  {"DRV_CFLAGS",
   "$DRV_CFLAGS -std=c11 -Wall -Wextra -Wno-unused-parameter -fPIC -O2"},

  {"LDFLAGS",
   "$LDFLAGS -ltss2-esys -ltss2-mu -ltss2-tctildr -ltss2-rc -lcrypto"},

  {"DRV_LDFLAGS",
   "$DRV_LDFLAGS -ltss2-esys -ltss2-mu -ltss2-tctildr -ltss2-rc -lcrypto"}
 ]}.

{profiles, [
    {test, [{deps, [{proper, "1.5.0"}]}]}
]}.
