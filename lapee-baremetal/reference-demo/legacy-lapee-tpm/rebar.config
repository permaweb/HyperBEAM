%% lapee_tpm — Erlang NIF wrapping libtss2-esys for TPM 2.0.
{erl_opts, [debug_info]}.

{deps, []}.

{plugins, [pc]}.

{provider_hooks,
 [{post, [{compile, {pc, compile}}, {clean, {pc, clean}}]}]}.

{port_specs,
 [{"priv/lapee_tpm_nif.so",
   ["c_src/lapee_tpm_nif.c", "c_src/tpm_helpers.c"]}]}.

{port_env,
 [
  %% Include erl_nif.h and tss2 headers.
  {"CFLAGS",
   "$CFLAGS -std=c11 -Wall -Wextra -Wno-unused-parameter -fPIC -O2 "
   "-I/Users/sam/src/hyperbeam/.claude/worktrees/sharp-lichterman/lapee-baremetal/work/tss2-prefix/include "
   "-I/Users/sam/src/hyperbeam/.claude/worktrees/sharp-lichterman/lapee-baremetal/work/tss2-prefix/include/tss2 "
   "-I/opt/homebrew/opt/openssl@3/include"},

  {"DRV_CFLAGS",
   "$DRV_CFLAGS -std=c11 -Wall -Wextra -Wno-unused-parameter -fPIC -O2 "
   "-I/Users/sam/src/hyperbeam/.claude/worktrees/sharp-lichterman/lapee-baremetal/work/tss2-prefix/include "
   "-I/Users/sam/src/hyperbeam/.claude/worktrees/sharp-lichterman/lapee-baremetal/work/tss2-prefix/include/tss2 "
   "-I/opt/homebrew/opt/openssl@3/include"},

  {"LDFLAGS",
   "$LDFLAGS "
   "-L/Users/sam/src/hyperbeam/.claude/worktrees/sharp-lichterman/lapee-baremetal/work/tss2-prefix/lib "
   "-L/opt/homebrew/opt/openssl@3/lib "
   "-Wl,-rpath,/Users/sam/src/hyperbeam/.claude/worktrees/sharp-lichterman/lapee-baremetal/work/tss2-prefix/lib "
   "-ltss2-esys -ltss2-mu -ltss2-tctildr -ltss2-rc -lcrypto"},

  {"DRV_LDFLAGS",
   "$DRV_LDFLAGS "
   "-L/Users/sam/src/hyperbeam/.claude/worktrees/sharp-lichterman/lapee-baremetal/work/tss2-prefix/lib "
   "-L/opt/homebrew/opt/openssl@3/lib "
   "-Wl,-rpath,/Users/sam/src/hyperbeam/.claude/worktrees/sharp-lichterman/lapee-baremetal/work/tss2-prefix/lib "
   "-ltss2-esys -ltss2-mu -ltss2-tctildr -ltss2-rc -lcrypto"}
 ]}.
