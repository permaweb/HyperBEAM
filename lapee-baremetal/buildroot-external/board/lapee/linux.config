# LapEE kernel configuration fragment.
#
# Merged on top of Buildroot's default x86_64 config. The settings here
# enforce the security posture the LapEE paper assumes:
#   * Secure Boot + measured boot via TPM 2.0
#   * dm-verity-sealed rootfs
#   * Hardened runtime (lockdown, module signing)
#   * IOMMU strict mode
#   * No shell-out paths, no kernel debug interfaces
#
# This is a fragment; actual Buildroot merges it with x86_64_defconfig.

# Base arch
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y

# Boot — EFI stub + UKI friendly.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_MIXED=y
CONFIG_EFI_VARS=y
CONFIG_EFI_RUNTIME_WRAPPERS=y

# TPM 2.0
CONFIG_TCG_TPM=y
CONFIG_HW_RANDOM_TPM=y
CONFIG_TCG_TIS=y
CONFIG_TCG_CRB=y

# IMA — measure executed files into PCR 10/11
CONFIG_INTEGRITY=y
CONFIG_IMA=y
CONFIG_IMA_MEASURE_PCR_IDX=10
CONFIG_IMA_LSM_RULES=y
CONFIG_IMA_APPRAISE=y
CONFIG_IMA_APPRAISE_BOOTPARAM=y

# dm-verity rootfs seal
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG=y

# Secure Boot + module signing
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_HASH="sha256"

# Kernel lockdown
CONFIG_SECURITY=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_CONFIDENTIALITY=y

# MAC + Yama for ptrace restriction
CONFIG_SECURITY_YAMA=y
CONFIG_LSM="yama,integrity,apparmor"

# IOMMU — Intel + AMD, strict default
CONFIG_IOMMU_SUPPORT=y
CONFIG_IOMMU_DEFAULT_DMA_STRICT=y
CONFIG_INTEL_IOMMU=y
CONFIG_INTEL_IOMMU_DEFAULT_ON=y
CONFIG_AMD_IOMMU=y

# Memory hardening
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_HARDENED_USERCOPY=y

# Kill attack surface
# No legacy /dev/mem, kmem, kexec
CONFIG_STRICT_DEVMEM=y
CONFIG_IO_STRICT_DEVMEM=y
# No kexec -> no boot-through-lockdown bypass
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# No kdump
# CONFIG_CRASH_DUMP is not set

# Network — minimum required for HyperBEAM
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_TCP_CONG_BBR=y
CONFIG_NETDEVICES=y
CONFIG_VIRTIO_NET=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_IGC=y
CONFIG_R8169=y

# NO USB HID / Bluetooth / audio / webcam — we don't want humans at the console.
# CONFIG_USB_HID is not set
# CONFIG_BT is not set
# CONFIG_SOUND is not set
# CONFIG_MEDIA_SUPPORT is not set

# Storage — NVMe + virtio for VM testing; host AHCI.
CONFIG_BLK_DEV=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_VIRTIO_BLK=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y

# Filesystems
CONFIG_EXT4_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Entropy
CONFIG_RANDOM_TRUST_BOOTLOADER=n
CONFIG_RANDOM_TRUST_CPU=n
